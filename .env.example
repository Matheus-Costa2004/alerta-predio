# Copie para .env (fora do git) e troque as senhas

# MongoDB local
MONGO_ROOT_USER=alerta_admin
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_DATABASE=alerta
MONGO_PORT=27017

# API
API_PORT=8080
# local | staging | production
APP_ENV=local
# No pipeline é o SHA do commit
APP_VERSION=local
# Insere o prédio de demonstração quando o banco está vazio
SEED_ENABLED=true
JAVA_OPTS=-XX:MaxRAMPercentage=75

# Triagem por IA: fake (sem chave, determinística) | gemini
IA_PROVEDOR=fake
# Chave do Google AI Studio; sem ela o alerta segue normal com classificação "indisponível"
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite

# Web Push (VAPID). Gere com: java scripts/GerarChavesVapid.java
# Sem as chaves o push fica desligado e o app atualiza por polling
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerta-predio@example.com

# mongo-express (docker compose --profile tools)
MONGO_EXPRESS_PORT=8081
ME_USER=admin
ME_PASSWORD=troque-esta-senha

# Fora do docker-compose (Render, mvn spring-boot:run)
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/alerta_staging?retryWrites=true&w=majority
# SPRING_PROFILES_ACTIVE=staging   # staging | prod
# PORT=8080                        # o Render injeta a própria
